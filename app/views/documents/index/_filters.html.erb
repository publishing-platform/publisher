<%= form_tag(documents_path, method: :get) do %>
  <div class="mb-3">
    <%= label_tag :title_or_url, t("documents.index.filter.title_or_url"), class: "form-label" %>
    <%= search_field_tag :title_or_url, nil, value: @filter_params[:title_or_url], class: "form-control" %>    
  </div>   

  <div class="mb-3">
    <% document_types = DocumentType.all.map { |d| [d.label, d.id] } %>    
    <%= label_tag :document_type, t("documents.index.filter.document_type"), class: "form-label" %>
    <%= select_tag :document_type, 
      options_for_select(document_types, @filter_params[:document_type]), 
      include_blank: true, 
      id: "document_type",
      class: "form-control" %>        
  </div>    

  <div class="mb-3">
    <% selectable_states = %w[draft
                              submitted_for_review
                              published
                              published_but_needs_2i
                              withdrawn
                              removed
                              failed_to_publish]

      states = selectable_states.map do |state|
        [t("user_facing_states.#{state}.name"), state]
      end
    %>    
    <%= label_tag :state, t("documents.index.filter.state"), class: "form-label" %>
    <%= select_tag :state, 
      options_for_select(states, @filter_params[:state]), 
      include_blank: true, 
      id: "state",
      class: "form-control" %>        
  </div>     

<% if false %>


  <div class="mb-3">
    <%= label_tag :role, "Role", class: "form-label" %>
    <%= select_tag "role", 
      options_for_select(filtered_user_roles.map(&:humanize).zip(filtered_user_roles), @filter_params[:role]), 
      include_blank: true, 
      id: "role",
      class: "form-control" %> 
  </div>  

  <div class="mb-3">
    <%= label_tag :status, "Status", class: "form-label" %>
    <%= select_tag "status", 
      options_for_select(User::USER_STATUSES.map(&:humanize).zip(User::USER_STATUSES), @filter_params[:status]), 
      include_blank: true, 
      id: "status",
      class: "form-control" %>        
  </div>    

  <div class="mb-3">
    <%= label_tag :organisation, "Organisation", class: "form-label" %>
    <%= select_tag "organisation", 
      options_for_select(filtered_organisations, @filter_params[:organisation]), 
      include_blank: true, 
      id: "organisation",
      class: "form-control" %>      
  </div>   
  
<% end %>

  <%= submit_tag "Filter", class: "btn btn-primary mb-3" %>  

  <p>
    <%= link_to "Clear all filters",
                documents_path %>
  </p>  
<% end %>
