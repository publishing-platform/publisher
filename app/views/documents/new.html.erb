<% content_for :title, t("documents.new.title")  %>
<% content_for :back_link, documents_path %>

<%= form_tag documents_path do %>

  <% has_error = @issues&.has_key?(:document_type) %>

  <%= field_set_tag nil, aria: { describedby: has_error ? "document_type-errors" : nil }, class: "mb-3" do %>
    <% @document_types.each do |document_type| %>
      <%= tag.div class: "form-check #{(has_error ? "is-invalid" : nil)}" do %>
        <%= radio_button_tag :document_type, 
            document_type.id,
            document_type.id == @document_type,
            class: "form-check-input #{(has_error ? "is-invalid" : nil)}"  %>

        <%= label_tag "document_type_#{document_type.id}", document_type.label, class: "form-check-label" %>
      <% end %>
    <% end %>

    <%= render "components/errors", {
      field: :document_type
    } %>    
  <% end %>

  <%= submit_tag "Continue", class: "btn btn-primary" %>   
<% end %>