<h2 class="h4"><%= t("documents.show.contents.title") %></h2>

<dl>
  <% @edition.document_type.contents.each do |field| %>
    <dt><%= t_doctype_field(@edition, "#{field.id}.label") %></dt>
    <dd><%= render("documents/show/contents/#{field.id}_field", edition: @edition) %></dd>
  <% end %>
</dl>
