<% if @edition.document.newly_created? %>
  <% content_for :title, t("editions.edit.title_new", document_type: @edition.document_type.label.downcase) %>
<% else %>
  <% content_for :title, t("editions.edit.title", title: @edition.title_or_fallback) %>
<% end %>
<% content_for :back_link, document_path(@edition.document) %>

<%= form_tag(
      edition_path(@edition.document),
      method: :patch
    ) do |f| %>

  <% @edition.document_type.contents.each do |field| %>
    <%= render "editions/edit/#{field.id}_field", edition: @edition, issues: @issues %>
  <% end %>

  <%= submit_tag "Save", class: "btn btn-primary" %>
<% end %>